<?xml version="1.0" encoding="utf-8"?>
<!-- 像素进度条（经验条 / 血条）：黑底方块，进度部分用 tint 上色 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape><solid android:color="#000000" /><stroke android:width="2dp" android:color="#FFF1E8" /></shape>
    </item>
    <item android:id="@android:id/progress" android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
        <clip><shape><solid android:color="#FFFFFF" /></shape></clip>
    </item>
</layer-list>
