<?xml version="1.0" encoding="utf-8"?>
<!-- 像素按钮：黑色描边 + 右下硬阴影；按下时去掉阴影并往右下移，看起来像按进去了 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:left="4dp" android:top="4dp">
                <shape><solid android:color="#000000" /></shape>
            </item>
            <item android:left="7dp" android:top="7dp" android:right="0dp" android:bottom="0dp">
                <shape><solid android:color="#00E436" /></shape>
            </item>
        </layer-list>
    </item>
    <item android:state_enabled="false">
        <layer-list>
            <item android:right="4dp" android:bottom="4dp">
                <shape><solid android:color="#000000" /></shape>
            </item>
            <item android:left="3dp" android:top="3dp" android:right="7dp" android:bottom="7dp">
                <shape><solid android:color="#5F574F" /></shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:left="4dp" android:top="4dp">
                <shape><solid android:color="#000000" /></shape>
            </item>
            <item android:right="4dp" android:bottom="4dp">
                <shape><solid android:color="#000000" /></shape>
            </item>
            <item android:left="3dp" android:top="3dp" android:right="7dp" android:bottom="7dp">
                <shape><solid android:color="#00E436" /></shape>
            </item>
            <item android:left="3dp" android:top="3dp" android:right="7dp" android:bottom="7dp" android:gravity="top">
                <shape><size android:height="3dp" /><solid android:color="#33FFFFFF" /></shape>
            </item>
        </layer-list>
    </item>
</selector>
