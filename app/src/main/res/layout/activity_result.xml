<?xml version="1.0" encoding="utf-8"?>
<!-- 结算页：过关显示星星、经验、升级、新徽章；失败显示在哪一战倒下，并建议回去复习。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/resultTitle"
            style="@style/PxText.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/lessonName"
            style="@style/PxText.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <com.pystarter.app.game.PixelSpriteView
            android:id="@+id/sprite"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_marginTop="16dp" />

        <LinearLayout
            android:id="@+id/starRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/subText"
            style="@style/PxText.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center" />

        <LinearLayout
            android:id="@+id/rewardBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/px_panel"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp" />

        <TextView
            android:id="@+id/extraText"
            style="@style/PxText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_banner"
            android:gravity="center"
            android:padding="12dp"
            android:textColor="@color/px_yellow"
            android:visibility="gone" />

        <TextView
            android:id="@+id/primary"
            style="@style/PxButton.Green"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp" />

        <TextView
            android:id="@+id/secondary"
            style="@style/PxButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/toMap"
            style="@style/PxButton.Gray"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/back_to_map" />
    </LinearLayout>
</ScrollView>
