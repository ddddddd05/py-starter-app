<?xml version="1.0" encoding="utf-8"?>
<!-- 学习页：小法师一步一步讲（概念卡片 → 比喻 → 动手试 → 小练习），全部不扣血。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/px_black"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:id="@+id/back"
            style="@style/PxText.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="12dp"
            android:text="@string/back_arrow" />

        <TextView
            android:id="@+id/title"
            style="@style/PxText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1" />

        <TextView
            android:id="@+id/stepText"
            style="@style/PxText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/px_blue" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/stepBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:progressDrawable="@drawable/px_bar"
        android:progressTint="@color/px_blue" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <com.pystarter.app.game.PixelSpriteView
                    android:id="@+id/npc"
                    android:layout_width="72dp"
                    android:layout_height="72dp" />

                <LinearLayout
                    android:id="@+id/bubble"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/px_card"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="16dp">

                    <TextView
                        android:id="@+id/speaker"
                        style="@style/PxText.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/npc_name"
                        android:textColor="@color/px_plum" />

                    <TextView
                        android:id="@+id/speech"
                        style="@style/PxText.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/px_black" />
                </LinearLayout>
            </LinearLayout>

            <!-- 动手试一试：示例代码可以改，点运行马上看结果 -->
            <LinearLayout
                android:id="@+id/exampleBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/exampleEditor"
                    style="@style/CodeText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine|textNoSuggestions|textVisiblePassword"
                    android:minLines="3" />

                <!-- 代码里用了 input() 时才显示：运行时要“喂”给程序的内容，一行对应一次 input() -->
                <LinearLayout
                    android:id="@+id/inputBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/PxText.Small"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/example_input_label"
                        android:textColor="@color/px_yellow" />

                    <EditText
                        android:id="@+id/exampleInput"
                        style="@style/CodeText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="top|start"
                        android:hint="@string/example_input_hint"
                        android:importantForAutofill="no"
                        android:inputType="textMultiLine|textNoSuggestions"
                        android:minLines="1"
                        android:textColorHint="@color/px_stone" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/runExample"
                        style="@style/PxButton.Green"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:text="@string/run_example" />

                    <TextView
                        android:id="@+id/slowExample"
                        style="@style/PxButton.Yellow"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:text="@string/slow_run" />

                    <TextView
                        android:id="@+id/resetExample"
                        style="@style/PxButton.Gray"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/reset_example" />
                </LinearLayout>

                <TextView
                    android:id="@+id/exampleOutput"
                    style="@style/OutputText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 小练习：答错只给解释，不扣血 -->
            <LinearLayout
                android:id="@+id/practiceBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/practiceCode"
                    style="@style/CodeText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/practiceOptions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/practiceExplain"
                    style="@style/PxText.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/px_dialog"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="16dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/px_black"
        android:orientation="horizontal"
        android:padding="8dp">

        <TextView
            android:id="@+id/prev"
            style="@style/PxButton.Gray"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/prev_step" />

        <TextView
            android:id="@+id/next"
            style="@style/PxButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="@string/next_step" />
    </LinearLayout>
</LinearLayout>
